<!--
  The asc MSI. Built by scripts/build_installer.py, which passes Version and AppDir.
  Per user by default, no admin. Program Files is the target because Windows Installer
  redirects it to %LOCALAPPDATA%\Programs for a per-user install (a profile folder as
  target fails validation, ICE38). So asc lands in %LOCALAPPDATA%\Programs\agent-speech-check
  and that folder goes on the user PATH. Upgrade, repair and uninstall first stop every
  asc daemon. Uninstall removes both, and asc's state in %LOCALAPPDATA%\agent-speech-check
  too (settings, logs, relay keys, the portable NVDA), unless KEEPDATA=1. Upgrades keep it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Agent Speech Check"
           Manufacturer="nibarAhmed"
           Version="$(Version)"
           UpgradeCode="45024D39-B418-4A36-B773-3A035735ECD7"
           Scope="perUserOrMachine">
    <!-- Every build gets a new ProductCode. Without AllowSameVersionUpgrades, two builds of
         one version install side by side and uninstalling one leaves the files. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Agent Speech Check is already installed." />
    <!-- perUserOrMachine is only there for the Program Files redirect above. PATH is set for
         the installing user alone, so a per-machine install would leave everyone else
         without asc: refuse it. -->
    <Launch Condition="Installed OR (MSIINSTALLPERUSER = 1 AND ALLUSERS &lt;&gt; 1)"
            Message="Agent Speech Check installs per user only. Run it without ALLUSERS=1 or MSIINSTALLPERUSER=&quot;&quot;." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Open a new terminal, then run asc setup. Terminals that were already open don't see the new PATH." />

    <!-- Stop every daemon before InstallValidate checks for files in use, so a daemon
         from the old version neither keeps running nor holds asc.exe. It runs the
         installed asc.exe, the old one during an upgrade. Each daemon may take 30 s,
         and QuietExec stops waiting (but leaves the process) after a minute by
         default, so it gets 5. A failure must not block the install: Return="ignore". -->
    <SetProperty Id="WixQuietExecCmdLine" Value="&quot;[INSTALLFOLDER]asc.exe&quot; _stop_all"
                 Before="StopDaemons" Sequence="execute" />
    <Property Id="WixQuietExecCmdTimeout" Value="300000" />
    <CustomAction Id="StopDaemons" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopDaemons" Before="InstallValidate"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <!-- The state folder goes with the product, through Windows Installer's own
         RemoveFile rows, so a failed uninstall puts it back. Not when an upgrade removes
         the old version, and not with KEEPDATA=1. Private (mixed case), so the command
         line can't point it elsewhere. -->
    <Property Id="AscData" Value="%LOCALAPPDATA%\agent-speech-check" />
    <Property Id="KEEPDATA" Secure="yes" />
    <!-- Only with WIXFAILWHENDEFERRED=1: fails just before the end, so CI can check rollback. -->
    <util:FailWhenDeferred />

    <!-- A short wizard: Welcome, then Next installs, then Finish. No licence page (MIT
         needs no click-through) and no folder choice. Repair and remove use WiX's standard
         maintenance dialogs. Silent installs (/qn) show none of this. -->
    <UI Id="AscUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />
    </UI>
    <UIRef Id="WixUI_Common" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="agent-speech-check" />
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(AppDir)\**" />
      <Component Id="UserPath" Directory="INSTALLFOLDER">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Action="set" Part="last" System="no" Permanent="no" />
        <RegistryValue Root="HKCU" Key="Software\agent-speech-check" Name="UserPath"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="StateFolder" Directory="INSTALLFOLDER">
        <util:RemoveFolderEx Property="AscData" On="uninstall"
                             Condition="NOT UPGRADINGPRODUCTCODE AND NOT KEEPDATA" />
        <RegistryValue Root="HKCU" Key="Software\agent-speech-check" Name="StateFolder"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
