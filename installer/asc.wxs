<!--
  The asc MSI. Built by scripts/build_installer.py, which passes Version and AppDir.
  Per user by default, no admin. Program Files is the target because Windows Installer
  redirects it to %LOCALAPPDATA%\Programs for a per-user install (a profile folder as
  target fails validation, ICE38). So asc lands in %LOCALAPPDATA%\Programs\agent-speech-check
  and that folder goes on the user PATH. Upgrade, repair and uninstall first stop every
  asc daemon. Uninstall removes both, and asc's state in %LOCALAPPDATA%\agent-speech-check
  too (settings, logs, relay keys, the portable NVDA), unless KEEPDATA=1. Upgrades keep it.
  Uninstall in Control Panel or Settings opens the wizard, which asks whether to keep that
  state (see UninstallEntry).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Agent Speech Check"
           Manufacturer="nibarAhmed"
           Version="$(Version)"
           UpgradeCode="45024D39-B418-4A36-B773-3A035735ECD7"
           Scope="perUserOrMachine">
    <!-- Every build gets a new ProductCode. Without AllowSameVersionUpgrades, two builds of
         one version install side by side and uninstalling one leaves the files. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Agent Speech Check is already installed." />
    <!-- perUserOrMachine is only there for the Program Files redirect above. PATH is set for
         the installing user alone, so a per-machine install would leave everyone else
         without asc: refuse it. -->
    <Launch Condition="Installed OR (MSIINSTALLPERUSER = 1 AND ALLUSERS &lt;&gt; 1)"
            Message="Agent Speech Check installs per user only. Run it without ALLUSERS=1 or MSIINSTALLPERUSER=&quot;&quot;." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Control Panel and Settings uninstall an MSI's own entry with basic UI, which shows
         none of the wizard, so the keep-data choice would never appear. Hide that entry and
         register our own (UninstallEntry) that opens the wizard. winget skips hidden entries
         too, so a winget manifest must name ours in AppsAndFeaturesEntries, with
         ProductCode: agent-speech-check. -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Open a new terminal, then run asc setup. Terminals that were already open don't see the new PATH." />

    <!-- Stop every daemon before InstallValidate checks for files in use, so a daemon
         from the old version neither keeps running nor holds asc.exe. It runs the
         installed asc.exe, the old one during an upgrade. Each daemon may take 30 s,
         and QuietExec stops waiting (but leaves the process) after a minute by
         default, so it gets 5. A failure must not block the install: Return="ignore". -->
    <SetProperty Id="WixQuietExecCmdLine" Value="&quot;[INSTALLFOLDER]asc.exe&quot; _stop_all"
                 Before="StopDaemons" Sequence="execute" />
    <Property Id="WixQuietExecCmdTimeout" Value="300000" />
    <CustomAction Id="StopDaemons" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopDaemons" Before="InstallValidate"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <!-- The state folder goes with the product, through Windows Installer's own
         RemoveFile rows, so a failed uninstall puts it back. Not when an upgrade removes
         the old version, and not with KEEPDATA=1. Private (mixed case), so the command
         line can't point it elsewhere. -->
    <Property Id="AscData" Value="%LOCALAPPDATA%\agent-speech-check" />
    <Property Id="KEEPDATA" Secure="yes" />
    <!-- Only with WIXFAILWHENDEFERRED=1: fails just before the end, so CI can check rollback. -->
    <util:FailWhenDeferred />

    <!-- A short wizard: Welcome, then Next installs, then Finish. No licence page (MIT
         needs no click-through) and no folder choice. Uninstalling: Welcome, KeepDataDlg, then
         WiX's confirmation. Silent installs and uninstalls (/qn) show none of this. -->
    <UI Id="AscUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <!-- Remove is the only maintenance choice, so skip WiX's Change, Repair or Remove page. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Property="WixUI_InstallMode" Value="Remove" Order="1" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="KeepDataDlg" Order="2" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="KeepDataDlg" />

      <!-- Between Welcome and the last confirmation: the checkbox sets KEEPDATA, as
           KEEPDATA=1 on the command line does. It comes first in the tab order, so focus
           (and a screen reader) lands on it; Enter still means Next. -->
      <Dialog Id="KeepDataDlg" Width="370" Height="270" Title="!(loc.KeepDataDlg_Title)">
        <Control Id="KeepData" Type="CheckBox" X="20" Y="150" Width="330" Height="18"
                 Property="KEEPDATA" CheckBoxValue="1" Text="!(loc.KeepDataDlgCheckBox)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceWelcomeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="!(loc.KeepDataDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="20"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.KeepDataDlgDescription)" />
        <Control Id="Body" Type="Text" X="20" Y="60" Width="330" Height="80" NoPrefix="yes"
                 Text="!(loc.KeepDataDlgBody)" />
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="agent-speech-check" />
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(AppDir)\**" />
      <Component Id="UserPath" Directory="INSTALLFOLDER">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Action="set" Part="last" System="no" Permanent="no" />
        <RegistryValue Root="HKCU" Key="Software\agent-speech-check" Name="UserPath"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="StateFolder" Directory="INSTALLFOLDER">
        <util:RemoveFolderEx Property="AscData" On="uninstall"
                             Condition="NOT UPGRADINGPRODUCTCODE AND NOT KEEPDATA" />
        <RegistryValue Root="HKCU" Key="Software\agent-speech-check" Name="StateFolder"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- The Control Panel and Settings entry, in place of the hidden one. Uninstall runs
           the wizard in maintenance mode; winget and other silent tools run
           QuietUninstallString, which removes the state unless they add KEEPDATA=1. -->
      <Component Id="UninstallEntry" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\agent-speech-check">
          <RegistryValue Name="DisplayName" Type="string" Value="[ProductName]" KeyPath="yes" />
          <RegistryValue Name="DisplayVersion" Type="string" Value="[ProductVersion]" />
          <RegistryValue Name="Publisher" Type="string" Value="[Manufacturer]" />
          <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]asc.exe" />
          <RegistryValue Name="UninstallString" Type="string" Value="MsiExec.exe /I[ProductCode]" />
          <RegistryValue Name="QuietUninstallString" Type="string" Value="MsiExec.exe /X[ProductCode] /qn" />
          <RegistryValue Name="NoModify" Type="integer" Value="1" />
          <RegistryValue Name="NoRepair" Type="integer" Value="1" />
        </RegistryKey>
      </Component>
    </Feature>
  </Package>
</Wix>
